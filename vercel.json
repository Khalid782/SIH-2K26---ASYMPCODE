{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/triage.ts": { "maxDuration": 30 },
    "api/test-gemini.ts": { "maxDuration": 20 },
    "api/facilities.ts": { "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/api/test-gemini", "destination": "/api/test-gemini" },
    { "source": "/api/triage", "destination": "/api/triage" },
    { "source": "/api/facilities", "destination": "/api/facilities" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
